# Defaults: zone example.com, addresses on 192.168.0.0/24.
# Change the values below when your site uses a different domain or network,
# then restart: ./scripts/stop.sh && ./scripts/start.sh
#
# Prefer editing this file. For local-only overrides (not committed), use
# config/lab.local.env with the same keys. Shell env vars always win.
# Loaded by scripts/load-config.sh (start, prepare, tests).

# =============================================================================
# Domain
# =============================================================================

# Forward DNS zone answered by this lab
DDNS_ZONE=example.com

# =============================================================================
# Network
# =============================================================================

# Lab IPv4 subnet (must be /24). Reverse zone and LAB_PREFIX are derived from this.
LAB_CIDR=192.168.0.0/24

# Bootstrap A/PTR records published at container start
DDNS_GW_IP=192.168.0.1
DDNS_STATIC_IP=192.168.0.10
DDNS_NS1_IP=192.168.0.53

# Upstream resolvers for names outside DDNS_ZONE (dnsmasq forwarders)
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# Optional overrides (normally derived from LAB_CIDR / host IPs above):
# LAB_PREFIX=192.168.0
# DDNS_REV_ZONE=0.168.192.in-addr.arpa
# DDNS_GW_PTR=1
# DDNS_STATIC_PTR=10
# DDNS_NS1_PTR=53

# =============================================================================
# Ports & auth
# =============================================================================

# Host ports published by Podman
DNS_PORT=53
UPDATE_PORT=5353

# TSIG key name (must match keys/update.key)
DDNS_KEY_NAME=update-key

# =============================================================================
# Container (optional)
# =============================================================================

# CONTAINER_NAME=dnsmasq-lab
# IMAGE_NAME=localhost/dnsmasq-lab:latest
